  "overlays": [
    { "id": "alerts", "params": "pos=top-center" },
    { "id": "goal",   "params": "pos=bottom-left&label=Follower%20Goal&target=500" },
    { "id": "chat",   "params": "pos=bottom-left&max=12&fade=90" },
    { "id": "labels", "params": "pos=bottom-right&rotate=8" },
    { "id": "scene",  "params": "mode=starting&t=300" }
