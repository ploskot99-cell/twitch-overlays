{
  "displayName": "Όνομα που βλέπει ο streamer",
  "channel": "to_kanali_tous",
  "skin": "default",

  "config": {
    "sources": ["chat"],
    "alerts": {
      "duration": 6500,
      "minCheer": 100,
      "templates": {
        "follow": { "eyebrow": "ΝΕΟ FOLLOW", "line": "{user}", "sub": "καλώς ήρθες!" }
